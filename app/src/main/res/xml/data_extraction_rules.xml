<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Keystore keys are never backed up or transferred, so the encrypted token files must not be either. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_tokens.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_tokens.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </device-transfer>
</data-extraction-rules>
