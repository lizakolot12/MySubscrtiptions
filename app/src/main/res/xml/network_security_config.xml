<?xml version="1.0" encoding="utf-8"?>
<!-- Allows cleartext HTTP only to the Android emulator's host-machine alias, for BuildConfig.BACKEND_BASE_URL
     during local development against docker-compose.yml. Everything else stays HTTPS-only by default. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.0.3</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
